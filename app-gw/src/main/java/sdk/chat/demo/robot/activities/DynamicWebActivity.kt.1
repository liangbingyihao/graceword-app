class DynamicWebActivity : AppCompatActivity() {

    companion object {
        private const val EXTRA_ACTIVITY_ID = "activity_id"
        private const val EXTRA_ACTIVITY_URL = "activity_url"
        private const val DEFAULT_ACTIVITY_ID = "default_activity"

        fun start(
            context: Context,
            activityId: String = DEFAULT_ACTIVITY_ID,
            directUrl: String? = null
        ) {
            val intent = Intent(context, DynamicWebActivity::class.java).apply {
                putExtra(EXTRA_ACTIVITY_ID, activityId)
                if (!directUrl.isNullOrEmpty()) {
                    putExtra(EXTRA_ACTIVITY_URL, directUrl)
                }
            }
            context.startActivity(intent)
        }
    }

    private lateinit var webView: WebView
    private lateinit var progressBar: ProgressBar
    private lateinit var errorLayout: View
    private lateinit var retryButton: View

    private val activityId: String by lazy {
        intent.getStringExtra(EXTRA_ACTIVITY_ID) ?: DEFAULT_ACTIVITY_ID
    }

    private val directUrl: String? by lazy {
        intent.getStringExtra(EXTRA_ACTIVITY_URL)
    }

    private val configManager = ConfigManager()
    private val imageCacheManager by lazy { ImageCacheManager(this) }
    private var currentUrl: String? = null

    // 协程作用域
    private val scope = CoroutineScope(Dispatchers.Main + SupervisorJob())

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        setContentView(R.layout.activity_dynamic_web)

        initViews()
        setupWebView()

        if (directUrl != null) {
            // 直接加载指定URL
            loadUrl(directUrl!!)
        } else {
            // 从配置加载
            loadActivityConfig()
        }
    }

    private fun initViews() {
        webView = findViewById(R.id.webView)
        progressBar = findViewById(R.id.progressBar)
        errorLayout = findViewById(R.id.layoutError)
        retryButton = findViewById(R.id.btnRetry)

        retryButton.setOnClickListener {
            errorLayout.isVisible = false
            loadActivityConfig()
        }
    }

    @SuppressLint("SetJavaScriptEnabled")
    private fun setupWebView() {
        val settings = webView.settings

        // 基本设置
        settings.javaScriptEnabled = true
        settings.domStorageEnabled = true
        settings.databaseEnabled = true
        settings.setSupportZoom(true)
        settings.builtInZoomControls = false
        settings.displayZoomControls = false
        settings.loadWithOverviewMode = true
        settings.useWideViewPort = true
        settings.setSupportMultipleWindows(true)

        // 缓存设置
        settings.cacheMode = WebSettings.LOAD_DEFAULT
//        settings.setAppCacheEnabled(true)
//        settings.setAppCachePath(cacheDir.absolutePath)
        settings.databasePath = cacheDir.absolutePath

        // 其他优化
        settings.loadsImagesAutomatically = true
        settings.blockNetworkImage = false
        settings.allowFileAccess = true
        settings.allowContentAccess = true

        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.LOLLIPOP) {
            settings.mixedContentMode = WebSettings.MIXED_CONTENT_ALWAYS_ALLOW
        }

        // 设置WebViewClient
        webView.webViewClient = object : WebViewClient() {
            override fun onPageStarted(view: WebView?, url: String?, favicon: Bitmap?) {
                super.onPageStarted(view, url, favicon)
                progressBar.isVisible = true
                errorLayout.isVisible = false
                currentUrl = url
            }

            override fun onPageFinished(view: WebView?, url: String?) {
                super.onPageFinished(view, url)
                progressBar.isVisible = false
                injectJavaScriptBridge()
            }

            override fun onReceivedError(
                view: WebView?,
                request: WebResourceRequest?,
                error: WebResourceError?
            ) {
                super.onReceivedError(view, request, error)
                if (request?.isForMainFrame == true) {
                    showError("页面加载失败: ${error?.description}")
                }
            }

            @Suppress("DEPRECATION")
            override fun onReceivedError(
                view: WebView?,
                errorCode: Int,
                description: String?,
                failingUrl: String?
            ) {
                super.onReceivedError(view, errorCode, description, failingUrl)
                showError("页面加载失败: $description")
            }

            // 拦截图片请求，使用原生缓存
            override fun shouldInterceptRequest(
                view: WebView?,
                request: WebResourceRequest?
            ): WebResourceResponse? {
                request?.let { req ->
                    val url = req.url.toString()
                    if (isImageUrl(url)) {
                        return interceptImageRequest(url)
                    }
                }
                return super.shouldInterceptRequest(view, request)
            }

            // 处理链接点击
            override fun shouldOverrideUrlLoading(
                view: WebView?,
                request: WebResourceRequest?
            ): Boolean {
                request?.url?.let { uri ->
                    val url = uri.toString()

                    // 处理JavaScript Bridge调用
                    if (url.startsWith("jsbridge://")) {
                        handleJSBridgeCall(url)
                        return true
                    }

                    // 处理电话、邮件等特殊协议
                    when (uri.scheme) {
                        "tel", "sms", "mailto" -> {
                            try {
                                val intent = Intent(Intent.ACTION_VIEW, uri)
                                startActivity(intent)
                            } catch (e: Exception) {
                                e.printStackTrace()
                            }
                            return true
                        }
                    }

                    // 处理外部链接
                    if (!url.startsWith("http://") && !url.startsWith("https://")) {
                        return false
                    }

                    // 处理应用内跳转
                    if (isInternalUrl(url)) {
                        return false
                    }

                    // 外部链接用浏览器打开
                    openExternalBrowser(url)
                    return true
                }
                return false
            }
        }

        // 设置WebChromeClient
        webView.webChromeClient = object : WebChromeClient() {
            override fun onProgressChanged(view: WebView?, newProgress: Int) {
                super.onProgressChanged(view, newProgress)
                progressBar.progress = newProgress
            }

            override fun onReceivedTitle(view: WebView?, title: String?) {
                super.onReceivedTitle(view, title)
                title?.let { setTitle(it) }
            }

            // 支持JavaScript对话框
            override fun onJsAlert(
                view: WebView?,
                url: String?,
                message: String?,
                result: JsResult
            ): Boolean {
                AlertDialog.Builder(this@DynamicWebActivity)
                    .setMessage(message)
                    .setPositiveButton("确定") { _, _ -> result.confirm() }
                    .setCancelable(false)
                    .show()
                return true
            }

            override fun onJsConfirm(
                view: WebView?,
                url: String?,
                message: String?,
                result: JsResult
            ): Boolean {
                AlertDialog.Builder(this@DynamicWebActivity)
                    .setMessage(message)
                    .setPositiveButton("确定") { _, _ -> result.confirm() }
                    .setNegativeButton("取消") { _, _ -> result.cancel() }
                    .setCancelable(false)
                    .show()
                return true
            }
        }

        // 添加JavaScript接口
        webView.addJavascriptInterface(WebAppInterface(this), "Android")
    }

    private fun loadActivityConfig() {
        scope.launch {
            progressBar.isVisible = true

            try {
                val config = configManager.getActivityConfig(activityId)
                if (config != null && config.isActive()) {
                    loadUrl(config.url)
                } else {
                    // 尝试获取最新配置
                    fetchAndLoadConfig()
                }
            } catch (e: Exception) {
                e.printStackTrace()
                showError("加载配置失败: ${e.message}")
            }
        }
    }

    private suspend fun fetchAndLoadConfig() {
        withContext(Dispatchers.IO) {
            try {
                val config = configManager.fetchActivityConfig(activityId)
                withContext(Dispatchers.Main) {
                    if (config != null && config.isActive()) {
                        loadUrl(config.url)
                    } else {
                        showError("活动暂不可用")
                    }
                }
            } catch (e: Exception) {
                withContext(Dispatchers.Main) {
                    showError("网络连接失败")
                }
            }
        }
    }

    private fun loadUrl(url: String) {
        webView.loadUrl(url)
    }

    private fun isImageUrl(url: String): Boolean {
        val imageExtensions = arrayOf(
            ".jpg", ".jpeg", ".png", ".gif", ".bmp", ".webp",
            ".svg", ".tiff", ".ico"
        )
        val lowerUrl = url.lowercase()
        return imageExtensions.any { lowerUrl.endsWith(it) }
    }

    private fun interceptImageRequest(url: String): WebResourceResponse? {
        return try {
            val bitmap = imageCacheManager.getImage(url)
            if (bitmap != null) {
                val mimeType = getMimeType(url)
                val response = createWebResourceResponse(bitmap, mimeType)
                response
            } else {
                // 异步下载并缓存
                scope.launch(Dispatchers.IO) {
                    imageCacheManager.downloadAndCacheImage(url)
                }
                null
            }
        } catch (e: Exception) {
            e.printStackTrace()
            null
        }
    }

    private fun getMimeType(url: String): String {
        return when {
            url.endsWith(".png", true) -> "image/png"
            url.endsWith(".jpg", true) || url.endsWith(".jpeg", true) -> "image/jpeg"
            url.endsWith(".gif", true) -> "image/gif"
            url.endsWith(".webp", true) -> "image/webp"
            url.endsWith(".svg", true) -> "image/svg+xml"
            else -> "image/*"
        }
    }

    private fun createWebResourceResponse(bitmap: Bitmap, mimeType: String): WebResourceResponse {
        val outputStream = ByteArrayOutputStream()
        when (mimeType) {
            "image/png" -> bitmap.compress(Bitmap.CompressFormat.PNG, 100, outputStream)
            "image/webp" -> bitmap.compress(Bitmap.CompressFormat.WEBP, 100, outputStream)
            else -> bitmap.compress(Bitmap.CompressFormat.JPEG, 80, outputStream)
        }
        val inputStream = ByteArrayInputStream(outputStream.toByteArray())
        return WebResourceResponse(mimeType, "UTF-8", inputStream)
    }

    private fun handleJSBridgeCall(url: String) {
        val uri = Uri.parse(url)
        val action = uri.host

        when (action) {
            "close" -> finish()
            "share" -> {
                val title = uri.getQueryParameter("title") ?: ""
                val content = uri.getQueryParameter("content") ?: ""
                val link = uri.getQueryParameter("link") ?: ""
                shareContent(title, content, link)
            }
            "getUserInfo" -> {
                val callback = uri.getQueryParameter("callback")
                getUserInfo(callback)
            }
            "toast" -> {
                val message = uri.getQueryParameter("message") ?: ""
                showToast(message)
            }
        }
    }

    private fun isInternalUrl(url: String): Boolean {
        // 判断是否为应用内链接
        val internalDomains = listOf(
            "yourdomain.com",
            "activity.yourdomain.com"
        )
        return internalDomains.any { url.contains(it) }
    }

    private fun openExternalBrowser(url: String) {
        try {
            val intent = Intent(Intent.ACTION_VIEW, Uri.parse(url))
            startActivity(intent)
        } catch (e: Exception) {
            e.printStackTrace()
            showError("无法打开链接")
        }
    }

    private fun showError(message: String) {
        progressBar.isVisible = false
        errorLayout.isVisible = true

        Snackbar.make(webView, message, Snackbar.LENGTH_LONG)
            .setAction("重试") { loadActivityConfig() }
            .show()
    }

    private fun showToast(message: String) {
        runOnUiThread {
            Toast.makeText(this, message, Toast.LENGTH_SHORT).show()
        }
    }

    private fun shareContent(title: String, content: String, link: String) {
        val intent = Intent(Intent.ACTION_SEND).apply {
            type = "text/plain"
            putExtra(Intent.EXTRA_SUBJECT, title)
            putExtra(Intent.EXTRA_TEXT, "$content\n$link")
        }
        startActivity(Intent.createChooser(intent, "分享到"))
    }

    private fun getUserInfo(callback: String?) {
        val userInfo = JSONObject().apply {
            put("userId", "123456")
            put("userName", "张三")
            put("avatar", "https://example.com/avatar.jpg")
        }.toString()

        callback?.let { cb ->
            webView.evaluateJavascript("$cb($userInfo)", null)
        }
    }

    private fun injectJavaScriptBridge() {
        val jsBridge = """
            // JavaScript Bridge
            window.JSBridge = {
                // 调用原生方法
                callNative: function(action, params, callback) {
                    const paramsStr = params ? '?' + new URLSearchParams(params).toString() : '';
                    const callbackName = callback || '';
                    const url = 'jsbridge://' + action + paramsStr;
                    if (callbackName) {
                        window[callbackName] = callback;
                    }
                    window.location.href = url;
                },
                
                // 注册原生调用JavaScript的方法
                registerHandler: function(handlerName, handler) {
                    window['_handler_' + handlerName] = handler;
                },
                
                // 调用JavaScript方法
                callHandler: function(handlerName, data) {
                    const handler = window['_handler_' + handlerName];
                    if (handler && typeof handler === 'function') {
                        handler(data);
                    }
                }
            };
            
            // 监听页面事件
            document.addEventListener('DOMContentLoaded', function() {
                // 页面加载完成，通知原生
                if (window.JSBridge) {
                    window.JSBridge.callNative('page_ready', {title: document.title});
                }
            });
            
            // 处理返回键
            window.addEventListener('popstate', function() {
                if (window.JSBridge) {
                    window.JSBridge.callNative('back_pressed');
                }
            });
            
            // 发送页面统计数据
            function sendPageView() {
                const data = {
                    url: window.location.href,
                    title: document.title,
                    timestamp: new Date().getTime()
                };

                if (window.JSBridge) {
                    window.JSBridge.callNative('page_view', data);
                }
            }
            
            // 初始化
            sendPageView();
        """

        webView.evaluateJavascript(jsBridge, null)
    }

    override fun onBackPressed() {
        if (webView.canGoBack()) {
            webView.goBack()
        } else {
            super.onBackPressed()
        }
    }

    override fun onDestroy() {
        super.onDestroy()
        scope.cancel()
        webView.destroy()
    }
}

// JavaScript接口类
class WebAppInterface(private val context: Context) {

    @JavascriptInterface
    fun showToast(message: String) {
        Toast.makeText(context, message, Toast.LENGTH_SHORT).show()
    }

    @JavascriptInterface
    fun getDeviceInfo(): String {
        return JSONObject().apply {
            put("platform", "Android")
            put("version", Build.VERSION.RELEASE)
            put("model", Build.MODEL)
            put("brand", Build.BRAND)
            put("screenWidth", context.resources.displayMetrics.widthPixels)
            put("screenHeight", context.resources.displayMetrics.heightPixels)
            put("density", context.resources.displayMetrics.density)
        }.toString()
    }

    @JavascriptInterface
    fun closePage() {
        (context as? Activity)?.finish()
    }

    @JavascriptInterface
    fun setNavigationBarColor(color: String) {
        (context as? AppCompatActivity)?.window?.navigationBarColor = Color.parseColor(color)
    }

    @JavascriptInterface
    fun setStatusBarColor(color: String) {
        (context as? AppCompatActivity)?.window?.statusBarColor = Color.parseColor(color)
    }

    @JavascriptInterface
    fun setStatusBarStyle(style: String) {
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.M) {
            (context as? AppCompatActivity)?.window?.decorView?.let { view ->
                var flags = view.systemUiVisibility
                if (style == "dark") {
                    flags = flags or View.SYSTEM_UI_FLAG_LIGHT_STATUS_BAR
                } else {
                    flags = flags and View.SYSTEM_UI_FLAG_LIGHT_STATUS_BAR.inv()
                }
                view.systemUiVisibility = flags
            }
        }
    }
}