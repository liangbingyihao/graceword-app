<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@id/root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="26dp"
    android:layout_marginTop="8dp"
    android:layout_marginRight="26dp"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    app:alignItems="flex_end"
    app:flexDirection="column"
    app:flexWrap="wrap">


    <com.google.android.material.button.MaterialButton
        android:id="@+id/replyText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="right"
        android:gravity="left"
        android:lineSpacingExtra="8dp"
        android:lineSpacingMultiplier="1"
        android:maxWidth="264dp"
        android:stateListAnimator="@null"
        android:textColor="@color/text_prompt"
        android:textSize="12sp"
        android:visibility="gone"
        app:backgroundTint="@color/bg_gray_button"
        app:cardElevation="0dp"
        app:cornerRadius="8dp"
        app:strokeWidth="0dp" />
    
    <FrameLayout
        android:id="@id/bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="right"
        android:background="@drawable/shape_outgoing_message"
        android:paddingLeft="22dp"
        android:paddingTop="12dp"
        android:paddingRight="22dp"
        android:visibility="gone"
        android:paddingBottom="12dp">
        <!-- 聊天文本 -->
        <TextView
            android:id="@+id/messageText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="8dp"
            android:lineSpacingMultiplier="1"
            android:maxWidth="264dp"
            android:textColor="@color/black"
            android:textIsSelectable="true"
            android:textSize="17sp" />
    </FrameLayout>

    <TextView
        android:id="@+id/feedback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:clickable="true"
        android:focusable="true"
        android:lineSpacingExtra="8dp"
        android:lineSpacingMultiplier="1"
        android:textColor="@color/item_text_normal"
        android:textSize="17sp"
        app:layout_alignSelf="flex_start" />

    <!--    <include layout="@layout/item_feed_explore" />-->

</LinearLayout>