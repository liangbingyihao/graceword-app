<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="284dp"
    android:layout_height="wrap_content"
    android:background="@mipmap/bg_billing_success"
    android:gravity="center"
    android:minHeight="230dp"
    android:orientation="vertical"
    android:padding="20dp">

    <ImageView
        android:id="@+id/vip_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:src="@mipmap/ic_crown" />

<!--    &lt;!&ndash; 订阅成功标题 &ndash;&gt;-->
<!--    <TextView-->
<!--        android:layout_width="wrap_content"-->
<!--        android:layout_height="wrap_content"-->
<!--        android:layout_marginBottom="14dp"-->
<!--        android:text="@string/subscription_success"-->
<!--        android:textColor="@color/item_text_selected"-->
<!--        android:textSize="18sp"-->
<!--        android:textStyle="bold" />-->

    <!-- 恭喜信息 -->
    <TextView
        android:id="@+id/main_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="25dp"
        android:text="@string/vip_already"
        android:textColor="@color/item_text_normal"
        android:textSize="14sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="18dp"
        android:background="#FAFAFA" />
    <!-- 我知道了按钮 -->
    <TextView
        android:id="@+id/got"
