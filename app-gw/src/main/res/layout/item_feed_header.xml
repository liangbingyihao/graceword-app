<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="26dp"
    android:layout_marginTop="8dp"
    android:layout_marginRight="26dp"
    android:layout_marginBottom="8dp"
    android:orientation="vertical">


    <include layout="@layout/item_feed_explore" />

    <androidx.core.widget.ContentLoadingProgressBar
        android:id="@+id/pb_progress"
        style="?android:attr/progressBarStyle"
        android:layout_width="match_parent"
        android:layout_height="86dp"
        android:layout_gravity="center_horizontal" />

    <TextView
        android:id="@+id/vip_text"
        android:layout_width="230dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/hint_vip_text_empty"
        android:textColor="@color/bg_bill_menu"
        android:textSize="14sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_start_vip"
        android:layout_width="108dp"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:stateListAnimator="@null"
        android:text="立即升级"
        android:layout_gravity="center"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="14sp"
        app:backgroundTint="@color/bg_bill_menu"
        app:cornerRadius="24dp"
        app:elevation="0dp"
        app:strokeWidth="0dp" />

    <View
        android:id="@+id/placeholder"
        android:layout_width="1dp"
        android:layout_height="400dp" />
</LinearLayout>