<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@id/root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="26dp"
    android:layout_marginTop="8dp"
    android:layout_marginRight="26dp"
    android:layout_marginBottom="8dp"
    android:orientation="vertical"
    app:alignItems="flex_end"
    app:flexDirection="column"
    app:flexWrap="wrap">

    <include layout="@layout/item_feed_user_text" />
    <include layout="@layout/item_feed_session" />
    <include layout="@layout/item_feed_process" />

    <TextView
        android:id="@+id/reply_error_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="left"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_click_shadow"
        android:drawablePadding="4dp"
        android:text="@string/ai_failed"
        android:textColor="@color/item_text_selected"
        android:textSize="17sp"
        app:drawableLeftCompat="@mipmap/ic_redo_red" />

    <TextView
        android:id="@+id/feedback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:lineSpacingExtra="8dp"
        android:lineSpacingMultiplier="1"
        android:textColor="@color/item_text_normal"
        android:textIsSelectable="true"
        android:textSize="17sp"
        app:layout_alignSelf="flex_start" />
    
<!--    <LinearLayout-->
<!--        android:id="@+id/ai_text_container"-->
<!--        android:layout_width="match_parent"-->
<!--        android:layout_height="wrap_content"-->
<!--        android:orientation="horizontal">-->

        <sdk.chat.demo.robot.ui.SongsContainerView
            android:id="@+id/songsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
<!--    </LinearLayout>-->

    <!-- 底部行（时间 + 操作菜单） -->
    <LinearLayout
        android:id="@+id/feedback_menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        app:alignItems="flex_start"
        app:flexDirection="row"
        app:justifyContent="flex_start"
        app:layout_alignSelf="flex_start">

        <ImageView
            android:id="@+id/btn_share_text"
            style="@style/FeedOperator"
            android:layout_marginStart="0dp"
            android:src="@mipmap/ic_share_black" />

        <ImageView
            android:id="@+id/btn_like_ai"
            style="@style/FeedOperator"
            android:src="@mipmap/ic_like_black" />

        <ImageView
            android:id="@+id/btn_del"
            style="@style/FeedOperator"
            android:src="@mipmap/ic_del_black" />

        <ImageView
            android:id="@+id/btn_redo"
            style="@style/FeedOperator"
            android:src="@mipmap/ic_redo_black" />
    </LinearLayout>
</LinearLayout>