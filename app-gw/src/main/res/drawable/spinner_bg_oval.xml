<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 圆角背景 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <stroke android:width="1dp" android:color="#E7E7E7"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>

    <!-- 右侧箭头 -->
    <item android:right="12dp" android:gravity="end|center_vertical">
        <bitmap android:src="@mipmap/ic_arrow_drop_down"
            android:tint="#666666"
            android:width="16dp"
            android:height="16dp"/>
    </item>
</layer-list>